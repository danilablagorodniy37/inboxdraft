# Copy to .env and fill in what you use. Nothing here is required for `make demo`:
# without an API key the app runs with a fake model so you can click through the UI.

# --- model provider -----------------------------------------------------------
# anthropic | openai | fake | auto (auto picks anthropic, then openai, then fake)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # optional, needs `pip install "inboxdraft[openai]"`
DRAFT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# --- embeddings (the index of your documents) ---------------------------------
# fastembed (local, no key, default) | openai | hashing (tests only)
EMBEDDINGS_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- storage ------------------------------------------------------------------
# SQLite for a laptop or one small mailbox; PostgreSQL + pgvector for anything shared.
DATABASE_URL=sqlite:///data/inboxdraft.sqlite
# DATABASE_URL=postgresql+psycopg://inboxdraft:inboxdraft@localhost:5432/inboxdraft

# --- behaviour ----------------------------------------------------------------
FIRM_NAME=Wrenfield Accounting
FIRM_SIGNATURE=Kind regards,\nThe Wrenfield Accounting team
REPLY_FROM=hello@wrenfield.example
ESCALATION_REPLY_BY=the end of the next working day
CONFIDENCE_THRESHOLD=0.6
TOP_K=5
KNOWLEDGE_DIR=knowledge
INBOX_DIR=inbox
DEMO_MODE=true

# --- mailbox (optional; the demo reads .eml files from INBOX_DIR) --------------
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX

# --- sending (optional; without SMTP_HOST approved replies go to data/outbox) --
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# --- review UI ----------------------------------------------------------------
# APP_PASSWORD=                 # protects the UI with HTTP basic auth (user: staff)

# --- prices, USD per million tokens [input, output], for the cost column -------
# Check https://platform.claude.com/docs/en/about-claude/pricing and override here:
# MODEL_PRICES={"claude-sonnet-5-5": [3.0, 15.0], "claude-haiku-5-5": [0.10, 0.50]}
